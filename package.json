{
  "name": "scadlatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Add parameter-aware features to existing OpenSCAD models by selecting their faces.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-openscad.mjs",
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/engine/*.test.ts src/server/*.test.ts src/shared/*.test.ts",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "openscad-parser": "0.6.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
